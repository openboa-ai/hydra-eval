{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "score": {
      "type": "integer",
      "enum": [0, 1]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["verdict", "score", "reason"]
}
